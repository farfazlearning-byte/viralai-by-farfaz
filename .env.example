# ViralAI by FARFAZ — environment variables (NO real values in this file)
# Paste real values ONLY into the Vercel project's Environment Variables screen
# (Project → Settings → Environment Variables). Never paste them into chat,
# never commit them to git.

# Neon Postgres connection string (from the Neon console → Connection Details,
# use the pooled connection string). Stage 2 of the setup.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any long random string (32+ characters). Used to protect session handling.
# Generate one locally, e.g. `openssl rand -hex 32`, and paste it only in Vercel.
SESSION_SECRET=replace-with-a-long-random-string

# Vercel Blob read-write token (from Vercel → Storage → Blob → your store).
# Without it, media uploads pause gracefully; everything else still works.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
